rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('favoriteTruckStop' in data) || (data.favoriteTruckStop is string && data.favoriteTruckStop.size() <= 100)) &&
             (!('bloomRewardPoints' in data) || data.bloomRewardPoints is int) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidFavoriteItem(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.menuItemId is string && data.menuItemId.size() > 0 && data.menuItemId.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('price' in data) || (data.price is number && data.price >= 0)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserOrder(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.orderCode is string && data.orderCode.size() > 0 && data.orderCode.size() <= 32 &&
             (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0)) &&
             (!('tax' in data) || (data.tax is number && data.tax >= 0)) &&
             (!('tip' in data) || (data.tip is number && data.tip >= 0)) &&
             data.total is number && data.total >= 0 &&
             data.status in ['RECEIVED', 'GRILLING', 'FINISHING', 'READY', 'COMPLETED'] &&
             (!('pickupLocation' in data) || (data.pickupLocation is string && data.pickupLocation.size() <= 100)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // User Profile
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'name', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'email', 'phone', 'favoriteTruckStop', 'bloomRewardPoints', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'favoriteTruckStop', 'bloomRewardPoints', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // User Saved Favorites
      match /favorites/{favoriteId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(favoriteId) &&
                         incoming().keys().hasAll(['userId', 'menuItemId', 'name', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'menuItemId', 'name', 'price', 'category', 'createdAt']) &&
                         isValidFavoriteItem(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidFavoriteItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'category']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(favoriteId);
      }

      // User Order History
      match /orders/{orderId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(orderId) &&
                         incoming().keys().hasAll(['userId', 'orderCode', 'total', 'status', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'orderCode', 'subtotal', 'tax', 'tip', 'total', 'status', 'pickupLocation', 'summary', 'createdAt']) &&
                         isValidUserOrder(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidUserOrder(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(orderId);
      }
    }
  }
}
